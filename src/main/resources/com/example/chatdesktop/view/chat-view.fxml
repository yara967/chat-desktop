<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.chatdesktop.controller.ChatController"
        stylesheets="@../css/chat.css"
        styleClass="root-pane">

    <!-- ========================= -->
    <!-- CABEÇALHO -->
    <!-- ========================= -->

    <top>

        <HBox
                spacing="20"
                alignment="CENTER_LEFT"
                styleClass="header">

            <padding>
                <Insets
                        top="22"
                        right="28"
                        bottom="18"
                        left="28"/>
            </padding>

            <!-- TÍTULO -->

            <VBox
                    spacing="4"
                    HBox.hgrow="ALWAYS">

                <Label
                        text="✦ Chat IA"
                        styleClass="titulo"/>

                <Label
                        text="Seu assistente inteligente"
                        styleClass="subtitulo"/>

            </VBox>


            <!-- BOTÃO NOVA CONVERSA -->

            <Button
                    fx:id="botaoNovaConversa"
                    text="＋ Nova conversa"
                    onAction="#novaConversa"
                    styleClass="botao-nova-conversa"/>

        </HBox>

    </top>


    <!-- ========================= -->
    <!-- ÁREA DA CONVERSA -->
    <!-- ========================= -->

    <center>

        <VBox
                styleClass="chat-container">

            <padding>
                <Insets
                        top="15"
                        right="25"
                        bottom="15"
                        left="25"/>
            </padding>

            <TextArea
                    fx:id="areaChat"
                    editable="false"
                    wrapText="true"
                    promptText="A conversa aparecerá aqui..."
                    styleClass="area-chat"/>

        </VBox>

    </center>


    <!-- ========================= -->
    <!-- CAMPO DE MENSAGEM -->
    <!-- ========================= -->

    <bottom>

        <VBox
                spacing="8"
                styleClass="bottom-container">

            <padding>
                <Insets
                        top="10"
                        right="25"
                        bottom="25"
                        left="25"/>
            </padding>

            <HBox
                    spacing="10"
                    styleClass="input-container">

                <TextField
                        fx:id="campoMensagem"
                        promptText="Digite sua mensagem..."
                        HBox.hgrow="ALWAYS"
                        onAction="#enviarMensagem"
                        styleClass="campo-mensagem"/>

                <Button
                        fx:id="botaoEnviar"
                        text="➤"
                        prefWidth="55"
                        prefHeight="45"
                        onAction="#enviarMensagem"
                        styleClass="botao-enviar"/>

            </HBox>

            <Label
                    text="Groq • openai/gpt-oss-20b"
                    styleClass="rodape"/>

        </VBox>

    </bottom>

</BorderPane>