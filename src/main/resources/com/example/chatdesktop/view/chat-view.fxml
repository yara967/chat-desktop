<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import com.example.chatdesktop.animacoes.ParticulasFundo?>

<StackPane
        fx:id="rootPane"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.example.chatdesktop.controller.ChatController"
        stylesheets="@../css/chat.css"
        styleClass="root-pane">

    <!-- ========================================= -->
    <!-- FUNDO COM PARTÍCULAS -->
    <!-- ========================================= -->

    <ParticulasFundo
            StackPane.alignment="CENTER"
            mouseTransparent="true"/>


    <!-- ========================================= -->
    <!-- CONTEÚDO DO CHAT -->
    <!-- ========================================= -->

    <BorderPane>

        <!-- ========================= -->
        <!-- BARRA LATERAL -->
        <!-- ========================= -->

        <left>

            <VBox
                    prefWidth="220"
                    spacing="10"
                    styleClass="sidebar">

                <padding>
                    <Insets
                            top="25"
                            right="15"
                            bottom="20"
                            left="15"/>
                </padding>

                <Label
                        text="✦ Chat IA"
                        styleClass="sidebar-titulo"/>

                <Label
                        text="Seu assistente inteligente"
                        styleClass="sidebar-subtitulo"/>

                <Button
                        fx:id="botaoNovaConversa"
                        text="＋ Nova conversa"
                        onAction="#novaConversa"
                        maxWidth="Infinity"
                        styleClass="sidebar-botao-nova"/>

                <Label
                        text="HISTÓRICO"
                        styleClass="historico-titulo"/>

                <ScrollPane
                        fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                        styleClass="historico-scroll">

                    <content>

                        <VBox
                                fx:id="historicoBox"
                                spacing="6"
                                styleClass="historico-box"/>

                    </content>

                </ScrollPane>

                <Button
                        fx:id="botaoOpcoes"
                        text="⚙ Opções"
                        onAction="#abrirOpcoes"
                        maxWidth="Infinity"
                        styleClass="sidebar-botao-opcoes"/>

            </VBox>

        </left>


        <!-- ========================= -->
        <!-- ÁREA PRINCIPAL -->
        <!-- ========================= -->

        <center>

            <BorderPane>

                <!-- ========================= -->
                <!-- CABEÇALHO -->
                <!-- ========================= -->

                <top>

                    <HBox
                            spacing="12"
                            alignment="CENTER_LEFT"
                            styleClass="header">

                        <padding>
                            <Insets
                                    top="22"
                                    right="28"
                                    bottom="18"
                                    left="28"/>
                        </padding>

                        <VBox
                                spacing="4"
                                HBox.hgrow="ALWAYS">

                            <Label
                                    text="✦ Chat IA"
                                    styleClass="titulo"/>

                            <Label
                                    text="Seu assistente inteligente"
                                    styleClass="subtitulo"/>

                        </VBox>

                        <Button
                                fx:id="botaoCopiarResposta"
                                text="⧉ Copiar resposta"
                                onAction="#copiarResposta"
                                styleClass="botao-copiar-resposta"/>

                        <Button
                                fx:id="botaoTema"
                                text="☀ Claro"
                                onAction="#alternarTema"
                                styleClass="botao-tema"/>

                    </HBox>

                </top>


                <!-- ========================= -->
                <!-- ÁREA DA CONVERSA -->
                <!-- ========================= -->

                <center>

                    <VBox
                            styleClass="chat-container"
                            VBox.vgrow="ALWAYS">

                        <padding>
                            <Insets
                                    top="15"
                                    right="25"
                                    bottom="15"
                                    left="25"/>
                        </padding>

                        <ScrollPane
                                fx:id="scrollChat"
                                fitToWidth="true"
                                fitToHeight="true"
                                VBox.vgrow="ALWAYS"
                                styleClass="scroll-chat">

                            <content>

                                <VBox
                                        fx:id="chatBox"
                                        spacing="12"
                                        fillWidth="true"
                                        styleClass="chat-box"/>

                            </content>

                        </ScrollPane>

                    </VBox>

                </center>


                <!-- ========================= -->
                <!-- CAMPO DE MENSAGEM -->
                <!-- ========================= -->

                <bottom>

                    <VBox
                            spacing="8"
                            styleClass="bottom-container">

                        <padding>
                            <Insets
                                    top="10"
                                    right="25"
                                    bottom="25"
                                    left="25"/>
                        </padding>

                        <HBox
                                spacing="10"
                                styleClass="input-container">

                            <TextField
                                    fx:id="campoMensagem"
                                    promptText="Digite sua mensagem..."
                                    HBox.hgrow="ALWAYS"
                                    onAction="#enviarMensagem"
                                    styleClass="campo-mensagem"/>

                            <Button
                                    fx:id="botaoEnviar"
                                    text="➤"
                                    prefWidth="55"
                                    prefHeight="45"
                                    onAction="#enviarMensagem"
                                    styleClass="botao-enviar"/>

                        </HBox>

                        <!-- ========================= -->
                        <!-- MODELO DA IA -->
                        <!-- ========================= -->

                        <Label
                                text="Groq • openai/gpt-oss-20b"
                                styleClass="rodape"/>

                        <!-- ========================= -->
                        <!-- ORIGEM DA RESPOSTA -->
                        <!-- ========================= -->

                        <Label
                                fx:id="indicadorOrigem"
                                text=""
                                styleClass="indicador-origem"/>

                    </VBox>

                </bottom>

            </BorderPane>

        </center>

    </BorderPane>

</StackPane>